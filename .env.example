# ── IBM OpenChat Agent connection ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed.

# Base URL of your IBM OpenChat / watsonx.ai Assistants instance, e.g.:
#   https://your-tenant.assistants.watson.cloud.ibm.com
VITE_OPENCHAT_URL=

# UUID of the Procurement Approvals Workflow Agent (from assistantsData[0].uuid):
VITE_OPENCHAT_AGENT_ID=101351ed-2c41-4ec4-8a7e-1ddd8185bd5f

# API key for the OpenChat instance (if required by your tenant):
VITE_OPENCHAT_API_KEY=

# ── IBM Blueworks Live integration ────────────────────────────────────────────
# Base URL of your Blueworks Live tenant — use the base URL only, NOT the login page:
#   Classic instance: https://www.blueworkslive.com
#   US region:        https://us.blueworkslive.ibm.com
VITE_BWL_URL=https://www.blueworkslive.com

# Your Blueworks Live account name — the short slug from your account URL, e.g. "ibm-team"
# Find it: log in → check URL for ?account= or #accountName=  OR  Profile → Account Settings
VITE_BWL_ACCOUNT=bf0077984

# Your Blueworks Live login email and local API password.
# NOTE: IBM ID SSO passwords do NOT work here. You need a local BWL password:
#   Log in → Profile icon → Edit Profile → Change Password → set a local password
VITE_BWL_USERNAME=satyadev.yeramati@ibm.com
VITE_BWL_PASSWORD=Sivdev-952004
