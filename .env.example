# ── IBM OpenChat Agent connection ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed.

# Base URL of your IBM Watson Assistant instance, e.g.:
#   https://api.us-south.assistant.watson.cloud.ibm.com/instances/<id>
VITE_OPENCHAT_URL=

# UUID of the Procurement Approvals Workflow Agent (Draft Environment ID):
VITE_OPENCHAT_AGENT_ID=

# API key for the Watson Assistant instance:
VITE_OPENCHAT_API_KEY=

# ── IBM Blueworks Live integration ────────────────────────────────────────────
# Base URL of your Blueworks Live tenant — use the base URL only, NOT the login page.
# IBM-hosted (most accounts): https://ibm.blueworkslive.com
# Classic instance:           https://www.blueworkslive.com
VITE_BWL_URL=https://ibm.blueworkslive.com

# Your Blueworks Live account name — the short slug shown in the URL after login, e.g. "myorg"
VITE_BWL_ACCOUNT=

# OAuth2 client credentials for the Blueworks Live API.
# In Blueworks Live: Admin → API Access → create or copy an OAuth2 application.
VITE_BWL_CLIENT_ID=
VITE_BWL_CLIENT_SECRET=
